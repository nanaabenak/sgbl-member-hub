# Copy to .env and fill in the values before running the application.
FLASK_CONFIG=production

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Local PostgreSQL on the EC2 instance:
DATABASE_URL=postgresql://sgbl:CHANGE_ME@localhost:5432/sgbl_member_hub
# Later, Amazon RDS is just a different URL (no code changes):
# DATABASE_URL=postgresql://sgbl:CHANGE_ME@my-rds.xxxxxx.eu-west-1.rds.amazonaws.com:5432/sgbl_member_hub

SESSION_COOKIE_SECURE=true
BEHIND_HTTPS_PROXY=true
SESSION_LIFETIME_SECONDS=43200
SESSION_IDLE_TIMEOUT_SECONDS=7200

CLUB_NAME=AWS Student Builder Group
BUILDER_CARD_URL=/card/
