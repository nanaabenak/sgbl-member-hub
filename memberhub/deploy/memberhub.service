[Unit]
Description=SGBL Member Hub (Gunicorn)
After=network.target postgresql.service

[Service]
Type=simple
User=sgbl
Group=sgbl
WorkingDirectory=/opt/memberhub
EnvironmentFile=/opt/memberhub/.env
ExecStart=/opt/memberhub/venv/bin/gunicorn -c deploy/gunicorn_conf.py wsgi:application
Restart=always
RestartSec=5
KillSignal=SIGQUIT
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/memberhub /var/log/memberhub

[Install]
WantedBy=multi-user.target
